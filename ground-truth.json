    {
      "id": "gt15",
      "subject": [
        "role=*"
      ],
      "object": "orders/*",
      "actions": [
        "delete"
      ],
      "permission": "deny",
      "reason": "Không ai được xóa đơn hàng để phục vụ đối soát và lưu vết.",
      "condition": ""
    }
