{
  "rules": [
    {
      "id": "gt01",
      "subject": [
        "role=admin"
      ],
      "object": "*",
      "actions": [
        "*"
      ],
      "permission": "grant",
      "reason": "Quản trị viên hệ thống có toàn quyền quản lý kỹ thuật và cấu hình tổng thể.",
      "condition": ""
    },
    {
      "id": "gt02",
      "subject": [
        "role=admin"
      ],
      "object": "customers/*/customer_unique_id",
      "actions": [
        "read"
      ],
      "permission": "deny",
      "reason": "Quản trị viên kỹ thuật không được xem mã định danh khách hàng (dữ liệu cá nhân, LGPD/NIST IR 8504).",
      "condition": ""
    },
    {
      "id": "gt03",
      "subject": [
        "role=seller"
      ],
      "object": "order_items/*",
      "actions": [
        "read"
      ],
      "permission": "grant",
      "reason": "Người bán chỉ xem các dòng hàng thuộc về chính mình.",
      "condition": "user.id == resource.seller_id"
    },
    {
      "id": "gt04",
      "subject": [
        "role=seller"
      ],
      "object": "products/*",
      "actions": [
        "read"
      ],
      "permission": "grant",
      "reason": "Người bán xem danh mục sản phẩm để quản lý gian hàng.",
      "condition": ""
    },
    {
      "id": "gt05",
      "subject": [
        "role=seller"
      ],
      "object": "sellers/*",
      "actions": [
        "read",
        "write"
      ],
      "permission": "grant",
      "reason": "Người bán xem và cập nhật hồ sơ của chính mình.",
      "condition": "user.id == resource.seller_id"
    },
    {
      "id": "gt06",
      "subject": [
        "role=seller"
      ],
      "object": "customers/*",
      "actions": [
        "read"
      ],
      "permission": "deny",
      "reason": "Người bán không được xem thông tin cá nhân của khách hàng.",
      "condition": ""
    },
    {
      "id": "gt07",
      "subject": [
        "role=customer"
      ],
      "object": "orders/*",
      "actions": [
        "read"
      ],
      "permission": "grant",
      "reason": "Khách hàng chỉ xem đơn hàng của chính mình.",
      "condition": "user.id == resource.customer_id"
    },
    {
      "id": "gt08",
      "subject": [
        "role=customer"
      ],
      "object": "customers/*",
      "actions": [
        "read",
        "write"
      ],
      "permission": "grant",
      "reason": "Khách hàng xem và cập nhật hồ sơ cá nhân của mình.",
