<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head flex-between">
  <div>
    <h1>▶ Kịch bản Demo</h1>
    <p class="sub">Chạy kiểm thử THẬT trên dữ liệu MongoDB, bám sát các mục trong bài báo <i>Access Control on NoSQL Databases</i> (NIST IR 8504, Vincent C. Hu, 2024). Kết quả bên dưới là dữ liệu thật truy vấn trực tiếp từ database — không phải mô tả.</p>
  </div>
  <form method="POST" action="/demo/run-all">
    <button class="btn" type="submit">▶ Chạy tất cả kịch bản</button>
  </form>
</div>

<div class="alert info">
  Tài khoản dùng trong demo: <b>admin1</b>, <b>gv_toan</b>, <b>gv_van</b>, <b>sv_an</b>, <b>sv_binh</b>, <b>sv_chau</b> — tạo sẵn qua <code>npm run seed</code>. Mỗi kịch bản thao tác trực tiếp trên document thật của các tài khoản này.
</div>

<% scenarios.forEach(sc => {
  const result = results[sc.id];
%>
<div class="card scenario-card <%= result ? (result.pass ? 'pass' : 'fail') : '' %>">
  <div class="flex-between">
    <div>
      <h2 class="mt-0"><%= sc.title %></h2>
      <span class="pill">Bài báo: <%= sc.baibaoRef %></span>
    </div>
    <div>
      <% if (sc.run) { %>
      <form method="POST" action="/demo/run/<%= sc.id %>">
        <button class="btn small" type="submit">▶ Chạy kịch bản</button>
      </form>
      <% } else if (sc.link) { %>
      <a class="btn small secondary" href="<%= sc.link %>">Đi tới trang AI →</a>
      <% } %>
    </div>
  </div>

  <% if (!sc.run && sc.link) { %>
    <p class="small muted">Trang chức năng đầy đủ — bấm "Đi tới trang AI" để trải nghiệm: Admin nhập quy định → Gemini phân tích → Admin xác nhận.</p>
  <% } %>

  <% if (result) { %>
  <div class="result-box">
    <p class="small"><b>Input:</b> <%= result.input %></p>
    <% if (result.steps && result.steps.length) { %>
    <p class="small mt-0"><b>Truy vấn/thao tác thực thi:</b></p>
    <ul class="step-list">
      <% result.steps.forEach(s => { %><li><code><%= s %></code></li><% }) %>
    </ul>
    <% } %>
    <p class="small"><b>Kỳ vọng theo bài báo:</b> <%= result.expected %></p>
    <p class="small">
      <b>Trạng thái:</b>
      <span class="badge <%= result.pass ? 'allow' : 'deny' %>"><%= result.pass ? '✓ ĐẠT' : '✗ KHÔNG ĐẠT' %></span>
    </p>

    <% if (result.blocks && result.blocks.length) { %>
      <%- include('_blocks', { blocks: result.blocks }) %>
    <% } %>
  </div>
  <% } %>
</div>
<% }) %>

<%- include('../partials/layout-bottom') %>
