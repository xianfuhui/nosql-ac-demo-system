<%
/**
 * Partial render các khối dữ liệu THẬT lấy trực tiếp từ MongoDB cho mỗi
 * kịch bản demo — thay cho việc mô tả kết quả bằng câu văn.
 * `blocks` là mảng { type, title, data }.
 * type: 'record' | 'table' | 'diff' | 'tree' | 'graph' | 'code' | 'empty'
 */
function fmtVal(v) {
  if (v === null || v === undefined) return '—';
  if (v instanceof Date) return new Date(v).toLocaleString('vi-VN');
  if (typeof v === 'object') return JSON.stringify(v);
  return String(v);
}
%>
<% blocks.forEach(function(b) { %>
  <div style="margin-top:14px">
    <p class="small" style="font-weight:700; margin:0 0 6px"><%= b.title %></p>

    <% if (b.type === 'record') { %>
      <table>
        <tbody>
          <% Object.keys(b.data || {}).forEach(function(k) { %>
          <tr><td class="small muted" style="width:220px"><%= k %></td><td class="small"><b><%= fmtVal(b.data[k]) %></b></td></tr>
          <% }) %>
        </tbody>
      </table>

    <% } else if (b.type === 'table') { %>
      <% if (!b.data || b.data.length === 0) { %>
        <div class="result-box small muted">Tập kết quả rỗng — truy vấn thực thi thành công nhưng không có bản ghi nào khớp phạm vi quyền.</div>
      <% } else { %>
      <table>
        <thead><tr><% Object.keys(b.data[0]).forEach(function(k){ %><th><%= k %></th><% }) %></tr></thead>
        <tbody>
          <% b.data.forEach(function(row){ %>
          <tr><% Object.keys(row).forEach(function(k){ %><td class="small"><%= fmtVal(row[k]) %></td><% }) %></tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>

    <% } else if (b.type === 'diff') { %>
      <table>
        <thead><tr><th>Trường</th><th>Trước</th><th>Sau</th></tr></thead>
        <tbody>
          <% Object.keys(b.data.after || {}).forEach(function(k) {
               const bv = (b.data.before || {})[k];
               const av = b.data.after[k];
               const changed = fmtVal(bv) !== fmtVal(av);
          %>
          <tr style="<%= changed ? 'background:#fdf3e0' : '' %>">
            <td class="small"><%= k %></td>
            <td class="small <%= changed ? 'muted' : '' %>"><%= fmtVal(bv) %></td>
            <td class="small"><b><%= fmtVal(av) %></b><%= changed ? ' ✏️' : '' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>

    <% } else if (b.type === 'tree') { %>
      <% function renderTree(node, depth) { %>
        <div style="margin-left:<%= depth*20 %>px; padding:4px 0; <%= depth>0 ? 'border-left:2px solid var(--border); padding-left:10px' : '' %>">
          <span class="pill"><%= node.levelLabel %></span>
          <b class="small"><%= node.label %></b>
          <% if (node.value !== undefined) { %><span class="small muted"> = <%= fmtVal(node.value) %></span><% } %>
        </div>
        <% (node.children || []).forEach(function(c){ renderTree(c, depth+1); }) %>
      <% } %>
      <% renderTree(b.data, 0) %>

    <% } else if (b.type === 'graph') { %>
      <% if (!b.data.found) { %>
        <div class="result-box small">
          Đã duyệt đồ thị thật từ node <code><%= b.data.fromKey %></code> nhưng
          <b>KHÔNG tìm thấy</b> cạnh <code><%= b.data.permissionType %></code> nào dẫn tới
          <code><%= b.data.toKey %></code> — không có đường đi nào trong collection
          <code>graphedges</code> thỏa điều kiện.
        </div>
      <% } else { %>
        <div class="graph-chain">
          <% b.data.path.forEach(function(edge, i) { %>
            <% if (i===0) { %><span class="graph-node"><%= edge.from %></span><% } %>
            <span class="graph-edge">—[<%= edge.type %>]→</span>
            <span class="graph-node"><%= edge.to %></span>
          <% }) %>
        </div>
        <p class="small muted" style="margin-top:6px">Đường đi trên là các document THẬT truy vấn trực tiếp từ collection <code>graphedges</code> (không qua collection <code>policies</code>).</p>
      <% } %>

    <% } else if (b.type === 'code') { %>
      <pre><%= typeof b.data === 'string' ? b.data : JSON.stringify(b.data, null, 2) %></pre>
    <% } %>
  </div>
<% }) %>
