<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1><%= lop.tenLop %> <span class="pill"><%= lop.maLop %></span></h1>
  <p class="sub">Môn: <%= lop.monHocId.tenMon %> · GV: <%= lop.giangVienId.hoTen %> · Khoa: <%= lop.khoa %></p>
</div>

<div class="card">
  <div class="flex-between">
    <h2 class="mt-0">Danh sách sinh viên (<%= lop.sinhVienIds.length %>/<%= lop.siSoToiDa %>)</h2>
  </div>
  <% if (lop.sinhVienIds.length === 0) { %>
  <p class="muted small">Chưa có sinh viên nào trong lớp.</p>
  <% } else { %>
  <table>
    <thead><tr><th>Họ tên</th><th>Username</th><th>Khoa</th><% if (user.role!=='sinhvien') { %><th>Thao tác</th><% } %></tr></thead>
    <tbody>
      <% lop.sinhVienIds.forEach(s => { %>
      <tr>
        <td><%= s.hoTen %></td>
        <td><%= s.username %></td>
        <td class="small"><%= s.khoa || '—' %></td>
        <% if (user.role!=='sinhvien') { %>
        <td>
          <form method="POST" action="/classes/<%= lop._id %>/students/<%= s._id %>/remove" onsubmit="return confirm('Xóa sinh viên khỏi lớp?')">
            <button class="btn small danger" type="submit">Xóa khỏi lớp</button>
          </form>
        </td>
        <% } %>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <% if (user.role !== 'sinhvien') { %>
  <h3>Thêm sinh viên vào lớp</h3>
  <form method="POST" action="/classes/<%= lop._id %>/students/add" style="display:flex; gap:10px; align-items:flex-end">
    <div style="flex:1">
      <select name="sinhVienId" required>
        <% allStudents.forEach(s => { %>
        <option value="<%= s._id %>"><%= s.hoTen %> (<%= s.username %>)</option>
        <% }) %>
      </select>
    </div>
    <button class="btn" type="submit">Thêm</button>
  </form>
  <% } %>
</div>

<a class="btn secondary" href="/classes">← Quay lại danh sách lớp</a>
<%- include('../partials/layout-bottom') %>
