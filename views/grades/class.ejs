<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1>Bảng điểm · <%= lop.tenLop %></h1>
  <p class="sub">Môn: <%= lop.monHocId.tenMon %> · <%= canEdit ? 'Bạn có quyền nhập/sửa điểm lớp này.' : 'Bạn chỉ có quyền xem (read-only).' %></p>
</div>

<div class="card">
  <table>
    <thead><tr><th>Sinh viên</th><th>Chuyên cần</th><th>Giữa kỳ</th><th>Cuối kỳ</th><th>Tổng kết</th><th></th></tr></thead>
    <tbody>
      <% lop.sinhVienIds.forEach(sv => {
           const d = diemMap[String(sv._id)] || {};
           const formId = 'f_' + sv._id;
      %>
      <% if (canEdit) { %>
      <form id="<%= formId %>" method="POST" action="/grades/class/<%= lop._id %>/update/<%= sv._id %>"></form>
      <% } %>
      <tr>
        <td><%= sv.hoTen %> <span class="small muted">(<%= sv.username %>)</span></td>
        <% if (canEdit) { %>
          <td><input form="<%= formId %>" type="number" step="0.1" min="0" max="10" name="diemChuyenCan" value="<%= d.diemChuyenCan ?? '' %>" style="width:70px" /></td>
          <td><input form="<%= formId %>" type="number" step="0.1" min="0" max="10" name="diemGiuaKy" value="<%= d.diemGiuaKy ?? '' %>" style="width:70px" /></td>
          <td><input form="<%= formId %>" type="number" step="0.1" min="0" max="10" name="diemCuoiKy" value="<%= d.diemCuoiKy ?? '' %>" style="width:70px" /></td>
          <td><input form="<%= formId %>" type="number" step="0.1" min="0" max="10" name="diemTongKet" value="<%= d.diemTongKet ?? '' %>" style="width:70px" /></td>
          <td><button form="<%= formId %>" class="btn small" type="submit">Lưu</button>
            <% if (d._id) { %><a class="btn small secondary" href="/grades/history/<%= d._id %>">Lịch sử</a><% } %>
          </td>
        <% } else { %>
          <td><%= d.diemChuyenCan ?? '—' %></td>
          <td><%= d.diemGiuaKy ?? '—' %></td>
          <td><%= d.diemCuoiKy ?? '—' %></td>
          <td><b><%= d.diemTongKet ?? '—' %></b></td>
          <td><% if (d._id) { %><a class="btn small secondary" href="/grades/history/<%= d._id %>">Lịch sử</a><% } %></td>
        <% } %>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<a class="btn secondary" href="/classes/<%= lop._id %>">← Quay lại lớp học</a>
<%- include('../partials/layout-bottom') %>
