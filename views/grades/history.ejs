<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1>Lịch sử sửa điểm</h1>
  <p class="sub">Sinh viên: <%= diem.sinhVienId.hoTen %> · Lớp: <%= diem.lopHocId.tenLop %></p>
</div>
<div class="card">
  <% if (history.length === 0) { %>
  <div class="empty-state">Chưa có lần chỉnh sửa nào được ghi nhận.</div>
  <% } else { %>
  <table>
    <thead><tr><th>Thời gian</th><th>Người sửa</th><th>Trường</th><th>Giá trị cũ</th><th>Giá trị mới</th></tr></thead>
    <tbody>
      <% history.forEach(h => { %>
      <tr>
        <td class="small"><%= new Date(h.thoiGian).toLocaleString('vi-VN') %></td>
        <td class="small"><%= h.nguoiSua ? h.nguoiSua.hoTen : '—' %></td>
        <td class="small"><%= h.truong %></td>
        <td><%= h.giaTriCu ?? '—' %></td>
        <td><b><%= h.giaTriMoi ?? '—' %></b></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<a class="btn secondary" href="/grades">← Quay lại</a>
<%- include('../partials/layout-bottom') %>
