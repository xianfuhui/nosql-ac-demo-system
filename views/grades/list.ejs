<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1>Điểm</h1>
  <p class="sub">
    <% if (user.role==='sinhvien') { %>Chỉ hiển thị điểm của chính bạn (ownership-based access control).
    <% } else if (user.role==='giangvien') { %>Chỉ hiển thị điểm các lớp bạn phụ trách.
    <% } else { %>Toàn bộ điểm trong hệ thống.<% } %>
  </p>
</div>
<div class="card">
  <% if (grades.length===0) { %><div class="empty-state">Chưa có dữ liệu điểm.</div>
  <% } else { %>
  <table>
    <thead><tr>
      <% if (user.role!=='sinhvien') { %><th>Sinh viên</th><% } %>
      <th>Môn</th><th>Lớp</th><th>Chuyên cần</th><th>Giữa kỳ</th><th>Cuối kỳ</th><th>Tổng kết</th><th></th>
    </tr></thead>
    <tbody>
      <% grades.forEach(g => { %>
      <tr>
        <% if (user.role!=='sinhvien') { %><td><%= g.sinhVienId ? g.sinhVienId.hoTen : '—' %></td><% } %>
        <td class="small"><%= g.monHocId ? g.monHocId.tenMon : '—' %></td>
        <td class="small"><%= g.lopHocId ? g.lopHocId.tenLop : '—' %></td>
        <td><%= g.diemChuyenCan ?? '—' %></td>
        <td><%= g.diemGiuaKy ?? '—' %></td>
        <td><%= g.diemCuoiKy ?? '—' %></td>
        <td><b><%= g.diemTongKet ?? '—' %></b></td>
        <td>
          <a class="btn small secondary" href="/grades/history/<%= g._id %>">Lịch sử</a>
          <% if (user.role!=='sinhvien' && g.lopHocId) { %>
          <a class="btn small secondary" href="/grades/class/<%= g.lopHocId._id %>">Bảng điểm lớp</a>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/layout-bottom') %>
