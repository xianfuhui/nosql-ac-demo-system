<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head"><h1><%= student.hoTen %></h1><p class="sub"><%= student.username %> · <%= student.khoa || '—' %></p></div>

<div class="card" style="max-width:520px">
  <% if (user.role === 'admin') { %>
  <form method="POST" action="/students/<%= student._id %>">
    <label class="first">Họ tên</label>
    <input type="text" name="hoTen" value="<%= student.hoTen %>" required />
    <label>Email</label>
    <input type="email" name="email" value="<%= student.email || '' %>" />
    <label>Khoa</label>
    <input type="text" name="khoa" value="<%= student.khoa || '' %>" />
    <button class="btn" type="submit" style="margin-top:14px">Lưu</button>
  </form>
  <% } else { %>
  <table>
    <tr><td class="muted small">Họ tên</td><td><%= student.hoTen %></td></tr>
    <tr><td class="muted small">Username</td><td><%= student.username %></td></tr>
    <tr><td class="muted small">Email</td><td><%= student.email || '—' %></td></tr>
    <tr><td class="muted small">Khoa</td><td><%= student.khoa || '—' %></td></tr>
    <tr><td class="muted small">Lớp</td><td><%= student.lopId ? student.lopId.tenLop : '—' %></td></tr>
  </table>
  <p class="small muted" style="margin-top:10px">Giảng viên chỉ có quyền xem (không sửa) hồ sơ sinh viên.</p>
  <% } %>
</div>
<a class="btn secondary" href="/students">← Quay lại</a>
<%- include('../partials/layout-bottom') %>
