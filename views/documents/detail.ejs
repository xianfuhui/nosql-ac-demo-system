<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1><%= doc.tenTaiLieu %></h1>
  <p class="sub">Môn: <%= doc.monHocId.tenMon %> · Lớp: <%= doc.lopHocId ? doc.lopHocId.tenLop : 'Tất cả' %> · Người đăng: <%= doc.nguoiTaiLen.hoTen %></p>
</div>
<div class="card">
  <p><%= doc.moTa || '(không có mô tả)' %></p>
  <h3>Nội dung</h3>
  <div class="result-box"><%= doc.noiDung || '(trống)' %></div>
  <% if (user.role === 'admin' || String(doc.nguoiTaiLen._id) === String(user._id)) { %>
  <form method="POST" action="/documents/<%= doc._id %>/delete" style="margin-top:16px" onsubmit="return confirm('Xóa tài liệu này?')">
    <button class="btn danger small" type="submit">Xóa tài liệu</button>
  </form>
  <% } %>
</div>
<a class="btn secondary" href="/documents">← Quay lại</a>
<%- include('../partials/layout-bottom') %>
