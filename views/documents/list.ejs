<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head flex-between">
  <div>
    <h1>Tài liệu học tập</h1>
    <p class="sub"><%= user.role==='sinhvien' ? 'Chỉ hiển thị tài liệu của lớp bạn đang học.' : 'Tài liệu bạn đã đăng hoặc thuộc lớp bạn phụ trách.' %></p>
  </div>
  <% if (user.role !== 'sinhvien') { %><a class="btn" href="/documents/new">+ Đăng tài liệu</a><% } %>
</div>
<div class="card">
  <% if (docs.length===0) { %><div class="empty-state">Không có tài liệu nào trong phạm vi quyền của bạn.</div>
  <% } else { %>
  <table>
    <thead><tr><th>Tên tài liệu</th><th>Môn</th><th>Lớp</th><th>Người đăng</th><th></th></tr></thead>
    <tbody>
      <% docs.forEach(d => { %>
      <tr>
        <td><%= d.tenTaiLieu %></td>
        <td class="small"><%= d.monHocId ? d.monHocId.tenMon : '—' %></td>
        <td class="small"><%= d.lopHocId ? d.lopHocId.tenLop : 'Tất cả' %></td>
        <td class="small"><%= d.nguoiTaiLen ? d.nguoiTaiLen.hoTen : '—' %></td>
        <td><a class="btn small secondary" href="/documents/<%= d._id %>">Xem</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('../partials/layout-bottom') %>
