<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head"><h1><%= course ? 'Sửa môn học' : 'Thêm môn học' %></h1></div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card" style="max-width:520px">
  <form method="POST" action="<%= course ? '/courses/' + course._id : '/courses' %>">
    <label class="first">Mã môn</label>
    <input type="text" name="maMon" value="<%= course ? course.maMon : '' %>" <%= course ? 'readonly' : 'required' %> />
    <label>Tên môn</label>
    <input type="text" name="tenMon" value="<%= course ? course.tenMon : '' %>" required />
    <label>Khoa</label>
    <input type="text" name="khoa" value="<%= course ? course.khoa : '' %>" required />
    <label>Số tín chỉ</label>
    <input type="number" name="soTinChi" value="<%= course ? course.soTinChi : 3 %>" />
    <label>Giảng viên phụ trách</label>
    <select name="giangVienIds" multiple size="6">
      <% giangViens.forEach(g => { %>
      <option value="<%= g._id %>" <%= course && course.giangVienIds.map(String).includes(String(g._id)) ? 'selected':'' %>><%= g.hoTen %> (<%= g.username %>)</option>
      <% }) %>
    </select>
    <button class="btn" type="submit" style="margin-top:16px">Lưu</button>
    <a class="btn secondary" href="/courses">Hủy</a>
  </form>
</div>
<%- include('../partials/layout-bottom') %>
