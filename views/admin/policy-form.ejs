<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head"><h1><%= policy ? 'Sửa chính sách' : 'Thêm chính sách' %></h1></div>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<div class="card" style="max-width:560px">
  <form method="POST" action="<%= policy ? '/policies/' + policy._id : '/policies' %>">
    <label class="first">Tên chính sách</label>
    <input type="text" name="ten" value="<%= policy ? policy.ten : '' %>" required />
    <label>Mô tả</label>
    <input type="text" name="moTa" value="<%= policy ? policy.moTa : '' %>" />

    <h3>Subject attribute (chủ thể)</h3>
    <label class="first">Vai trò</label>
    <select name="role">
      <option value="">— Bất kỳ —</option>
      <option value="admin" <%= policy && policy.subjectAttr.role==='admin'?'selected':'' %>>admin</option>
      <option value="giangvien" <%= policy && policy.subjectAttr.role==='giangvien'?'selected':'' %>>giangvien</option>
      <option value="sinhvien" <%= policy && policy.subjectAttr.role==='sinhvien'?'selected':'' %>>sinhvien</option>
    </select>
    <label>Khoa (để trống = không giới hạn)</label>
    <input type="text" name="khoaSubject" value="<%= policy ? (policy.subjectAttr.khoa||'') : '' %>" />
    <label>Phạm vi (scope)</label>
    <select name="scope">
      <option value="any" <%= policy && policy.subjectAttr.scope==='any'?'selected':'' %>>any — không giới hạn thêm</option>
      <option value="own" <%= policy && policy.subjectAttr.scope==='own'?'selected':'' %>>own — chỉ tài nguyên của chính mình</option>
      <option value="assigned" <%= policy && policy.subjectAttr.scope==='assigned'?'selected':'' %>>assigned — chỉ tài nguyên được phân công</option>
    </select>

    <h3>Edge (hành động)</h3>
    <select name="action">
      <option value="read" <%= policy && policy.action==='read'?'selected':'' %>>read</option>
      <option value="create" <%= policy && policy.action==='create'?'selected':'' %>>create</option>
      <option value="update" <%= policy && policy.action==='update'?'selected':'' %>>update</option>
      <option value="delete" <%= policy && policy.action==='delete'?'selected':'' %>>delete</option>
    </select>

    <h3>Object attribute (đối tượng)</h3>
    <label class="first">Loại tài nguyên</label>
    <select name="resourceType">
      <option value="diem" <%= policy && policy.objectAttr.resourceType==='diem'?'selected':'' %>>diem (điểm)</option>
      <option value="tailieu" <%= policy && policy.objectAttr.resourceType==='tailieu'?'selected':'' %>>tailieu</option>
      <option value="lophoc" <%= policy && policy.objectAttr.resourceType==='lophoc'?'selected':'' %>>lophoc</option>
      <option value="monhoc" <%= policy && policy.objectAttr.resourceType==='monhoc'?'selected':'' %>>monhoc</option>
      <option value="user" <%= policy && policy.objectAttr.resourceType==='user'?'selected':'' %>>user</option>
      <option value="log" <%= policy && policy.objectAttr.resourceType==='log'?'selected':'' %>>log</option>
      <option value="policy" <%= policy && policy.objectAttr.resourceType==='policy'?'selected':'' %>>policy</option>
    </select>
    <label>Khoa (object, để trống = không giới hạn)</label>
    <input type="text" name="khoaObject" value="<%= policy ? (policy.objectAttr.khoa||'') : '' %>" />

    <h3>Hiệu lực</h3>
    <select name="effect">
      <option value="allow" <%= policy && policy.effect==='allow'?'selected':'' %>>allow</option>
      <option value="deny" <%= policy && policy.effect==='deny'?'selected':'' %>>deny</option>
    </select>
    <label>Độ ưu tiên (số nhỏ hơn = ưu tiên hơn)</label>
    <input type="number" name="priority" value="<%= policy ? policy.priority : 10 %>" />

    <% if (policy) { %>
    <label style="display:flex;align-items:center;gap:8px;margin-top:14px">
      <input type="checkbox" name="active" style="width:auto" <%= policy.active?'checked':'' %> /> Đang bật
    </label>
    <% } %>

    <button class="btn" type="submit" style="margin-top:16px">Lưu</button>
    <a class="btn secondary" href="/policies">Hủy</a>
  </form>
</div>
<%- include('../partials/layout-bottom') %>
