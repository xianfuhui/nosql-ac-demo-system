<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1><%= account ? 'Sửa tài khoản' : 'Thêm tài khoản mới' %></h1>
  <p class="sub">Gán vai trò (admin / giảng viên / sinh viên) và phạm vi phụ trách quyết định tài nguyên người này được truy cập.</p>
</div>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<div class="card" style="max-width:560px">
  <form method="POST" action="<%= account ? '/accounts/' + account._id : '/accounts' %>">
    <label class="first">Tên đăng nhập</label>
    <input type="text" name="username" value="<%= account ? account.username : '' %>" <%= account ? 'readonly' : 'required' %> />

    <label>Họ tên</label>
    <input type="text" name="hoTen" value="<%= account ? account.hoTen : '' %>" required />

    <label>Email</label>
    <input type="email" name="email" value="<%= account ? account.email : '' %>" />

    <label>Vai trò</label>
    <select name="role" id="roleSelect" onchange="toggleFields()">
      <option value="sinhvien" <%= account && account.role==='sinhvien' ? 'selected':'' %>>Sinh viên</option>
      <option value="giangvien" <%= account && account.role==='giangvien' ? 'selected':'' %>>Giảng viên</option>
      <option value="admin" <%= account && account.role==='admin' ? 'selected':'' %>>Quản trị viên</option>
    </select>

    <label>Khoa</label>
    <input type="text" name="khoa" placeholder="VD: CNTT" value="<%= account ? (account.khoa||'') : '' %>" />

    <div id="svFields">
      <label>Lớp đang học (sinh viên)</label>
      <select name="lopId">
        <option value="">— Chưa có lớp —</option>
        <% lopHocs.forEach(l => { %>
        <option value="<%= l._id %>" <%= account && String(account.lopId)===String(l._id) ? 'selected':'' %>><%= l.tenLop %> (<%= l.maLop %>)</option>
        <% }) %>
      </select>
    </div>

    <div id="gvFields">
      <label>Lớp phụ trách (giảng viên)</label>
      <select name="lopPhuTrach" multiple size="5">
        <% lopHocs.forEach(l => { %>
        <option value="<%= l._id %>" <%= account && account.lopPhuTrach && account.lopPhuTrach.map(String).includes(String(l._id)) ? 'selected':'' %>><%= l.tenLop %> (<%= l.maLop %>)</option>
        <% }) %>
      </select>
      <label>Môn phụ trách (giảng viên)</label>
      <select name="monPhuTrach" multiple size="5">
        <% monHocs.forEach(m => { %>
        <option value="<%= m._id %>" <%= account && account.monPhuTrach && account.monPhuTrach.map(String).includes(String(m._id)) ? 'selected':'' %>><%= m.tenMon %> (<%= m.maMon %>)</option>
        <% }) %>
      </select>
    </div>

    <label><%= account ? 'Đặt lại mật khẩu (để trống nếu không đổi)' : 'Mật khẩu' %></label>
    <input type="password" name="<%= account ? 'newPassword' : 'password' %>" placeholder="Mặc định: 123456" />

    <% if (account) { %>
    <label style="display:flex;align-items:center;gap:8px;margin-top:14px">
      <input type="checkbox" name="active" style="width:auto" <%= account.active ? 'checked':'' %> /> Tài khoản hoạt động
    </label>
    <% } %>

    <button class="btn" type="submit" style="margin-top:18px">Lưu</button>
    <a class="btn secondary" href="/accounts">Hủy</a>
  </form>
</div>

<script>
function toggleFields(){
  const role = document.getElementById('roleSelect').value;
  document.getElementById('svFields').style.display = role === 'sinhvien' ? 'block' : 'none';
  document.getElementById('gvFields').style.display = role === 'giangvien' ? 'block' : 'none';
}
toggleFields();
</script>
<%- include('../partials/layout-bottom') %>
