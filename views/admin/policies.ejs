<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head flex-between">
  <div>
    <h1>Chính sách phân quyền (ABAC)</h1>
    <p class="sub">Mỗi chính sách là một "đường đi" subject attribute → action → object attribute, lưu trực tiếp trong NoSQL — đúng mô hình đồ thị §3.2.3 của bài báo.</p>
  </div>
  <a class="btn" href="/policies/new">+ Thêm chính sách</a>
</div>

<div class="card">
  <% policies.forEach(p => { %>
  <div style="padding:12px 0; border-bottom:1px solid var(--border)">
    <div class="flex-between">
      <div>
        <b><%= p.ten %></b>
        <span class="badge <%= p.effect==='allow' ? 'allow' : 'deny' %>"><%= p.effect %></span>
        <span class="badge <%= p.active ? 'allow' : 'deny' %>"><%= p.active ? 'Đang bật' : 'Đã tắt' %></span>
        <span class="pill">ưu tiên <%= p.priority %></span>
      </div>
      <div>
        <a class="btn small secondary" href="/policies/<%= p._id %>/edit">Sửa</a>
        <form style="display:inline" method="POST" action="/policies/<%= p._id %>/toggle">
          <button class="btn small secondary" type="submit"><%= p.active ? 'Tắt' : 'Bật' %></button>
        </form>
        <form style="display:inline" method="POST" action="/policies/<%= p._id %>/delete" onsubmit="return confirm('Xóa chính sách này?')">
          <button class="btn small danger" type="submit">Xóa</button>
        </form>
      </div>
    </div>
    <div class="graph-chain">
      <span class="graph-node">subject: <%= p.subjectAttr.role || 'bất kỳ vai trò' %><%= p.subjectAttr.khoa ? ' · khoa='+p.subjectAttr.khoa : '' %> (<%= p.subjectAttr.scope %>)</span>
      <span class="graph-edge">— can <%= p.action %> →</span>
      <span class="graph-node">object: <%= p.objectAttr.resourceType %><%= p.objectAttr.khoa ? ' · khoa='+p.objectAttr.khoa : '' %></span>
    </div>
    <% if (p.moTa) { %><p class="small muted mt-0"><%= p.moTa %></p><% } %>
  </div>
  <% }) %>
</div>
<%- include('../partials/layout-bottom') %>
