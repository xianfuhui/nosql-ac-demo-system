<%- include('../partials/layout-top', { title, active }) %>
<div class="page-head">
  <h1>AI hỗ trợ tạo quy tắc phân quyền</h1>
  <p class="sub">Bài báo §4.8 — dùng NLP để chuyển quy định viết bằng ngôn ngữ tự nhiên thành quy tắc access control hình thức. Admin luôn kiểm tra & xác nhận trước khi áp dụng.</p>
</div>

<div class="card">
  <h2 class="mt-0">1. Cấu hình Gemini API key</h2>
  <% if (hasKey) { %>
    <p class="small">Đang dùng key: <code><%= keyPreview %></code></p>
  <% } else { %>
    <div class="alert warn">Chưa cấu hình API key. Bạn có thể nhập ở đây, hoặc đặt biến môi trường <code>GEMINI_API_KEY</code> trong file <code>.env</code>.</div>
  <% } %>
  <form method="POST" action="/ai/save-key" style="display:flex; gap:10px; align-items:flex-end; margin-top:10px">
    <div style="flex:1">
      <input type="password" name="apiKey" placeholder="Dán Gemini API key tại đây..." />
    </div>
    <button class="btn secondary" type="submit">Lưu key</button>
  </form>
</div>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<div class="card">
  <h2 class="mt-0">2. Nhập quy định bằng tiếng Việt</h2>
  <form method="POST" action="/ai/suggest">
    <textarea name="quyDinh" rows="6" placeholder="VD: Giảng viên khoa CNTT chỉ được sửa điểm của sinh viên trong lớp mình phụ trách. Sinh viên chỉ được xem điểm của chính mình, không được xem điểm bạn khác..."><%= inputText %></textarea>
    <button class="btn" type="submit" style="margin-top:12px">Phân tích & đề xuất quy tắc</button>
  </form>
</div>

<% if (suggestions && suggestions.length) { %>
<div class="card">
  <h2 class="mt-0">3. Đề xuất từ AI — chọn quy tắc muốn áp dụng</h2>
  <form method="POST" action="/ai/confirm">
    <% suggestions.forEach((s, i) => { %>
    <div style="padding:10px 0; border-bottom:1px solid var(--border)">
      <label style="display:flex; align-items:flex-start; gap:10px; font-weight:400">
        <input type="checkbox" name="chosen" value="<%= i %>" style="width:auto; margin-top:4px" checked />
        <span>
          <b><%= s.ten %></b><br/>
          <span class="small muted"><%= s.moTa %></span>
          <% if (s.formalRule) { %>
          <pre style="margin:8px 0"><%= s.formalRule %></pre>
          <% } %>
          <div class="graph-chain">
            <span class="graph-node">subject: <%= s.subjectAttr.role || 'bất kỳ' %><%= s.subjectAttr.khoa ? ' · '+s.subjectAttr.khoa : '' %> (<%= s.subjectAttr.scope %>)</span>
            <span class="graph-edge">— can <%= s.action %> →</span>
            <span class="graph-node">object: <%= s.objectAttr.resourceType %><%= s.objectAttr.khoa ? ' · '+s.objectAttr.khoa : '' %></span>
            <span class="badge <%= s.effect==='allow'?'allow':'deny' %>"><%= s.effect %></span>
          </div>
        </span>
      </label>
    </div>
    <% }) %>
    <button class="btn" type="submit" style="margin-top:14px">✓ Xác nhận & tạo các quy tắc đã chọn</button>
  </form>
  <form method="POST" action="/ai/discard" style="display:inline">
    <button class="btn secondary" type="submit" style="margin-top:14px">Hủy đề xuất</button>
  </form>
</div>
<% } %>

<%- include('../partials/layout-bottom') %>
